#!/usr/bin/env bash
set -euo pipefail

ROOT_DIR="$(cd "$(dirname "$0")" && pwd)"

usage() {
  cat <<'USAGE'
Usage: ./tunlet <command> [options]

Commands:
  install [package]  Install or rebuild the runtime image
  start              Start Tunlet and sign in to aTrust
  status             Show the current status
  stop               Disconnect and stop Tunlet
  credentials        Inspect or delete saved passwords
  uninstall          Remove Tunlet runtime data
  help               Show this help

Examples:
  ./tunlet install
  ./tunlet start
  ./tunlet stop
USAGE
}

show_status() {
  local all_containers
  local running_containers
  local response
  local token_file="${ROOT_DIR}/.local/helper-token"

  if ! command -v container >/dev/null 2>&1; then
    echo "Apple Container: not installed"
    echo "Tunlet: stopped"
    return 0
  fi

  if ! container system status >/dev/null 2>&1; then
    echo "Apple Container: stopped"
    echo "Tunlet: stopped"
    return 0
  fi

  echo "Apple Container: running"
  all_containers="$(container list --all --format json 2>/dev/null || true)"
  running_containers="$(container list --format json 2>/dev/null || true)"

  if [[ "${running_containers}" == *'"id":"tunlet"'* ]]; then
    echo "Tunlet container: running"
    if [[ -f "${token_file}" ]]; then
      response="$(curl --silent --max-time 3 \
        --header "Authorization: Bearer $(<"${token_file}")" \
        http://127.0.0.1:54680/status 2>/dev/null || true)"
      if [[ "${response}" == *'"connected":true'* ]]; then
        echo "aTrust tunnel: connected"
        echo "SOCKS5: 127.0.0.1:11080"
      else
        echo "aTrust tunnel: disconnected or unknown"
      fi
    fi
  elif [[ "${all_containers}" == *'"id":"tunlet"'* ]]; then
    echo "Tunlet container: stopped"
  else
    echo "Tunlet container: not found"
  fi

  if container image list 2>/dev/null | awk \
    '$1 == "tunlet-runtime" && $2 == "local-arm64" { found = 1 } END { exit !found }'; then
    echo "Runtime image: installed"
  else
    echo "Runtime image: not installed"
  fi
}

command_name="${1:-help}"
if [[ "$#" -gt 0 ]]; then
  shift
fi

case "${command_name}" in
  install)
    exec "${ROOT_DIR}/scripts/setup.sh" "$@"
    ;;
  start)
    [[ "$#" == 0 ]] || {
      echo "The start command does not accept options." >&2
      exit 2
    }
    exec "${ROOT_DIR}/scripts/start.sh"
    ;;
  status)
    [[ "$#" == 0 ]] || {
      echo "The status command does not accept options." >&2
      exit 2
    }
    show_status
    ;;
  stop)
    [[ "$#" == 0 ]] || {
      echo "The stop command does not accept options." >&2
      exit 2
    }
    exec "${ROOT_DIR}/scripts/stop.sh"
    ;;
  credentials)
    exec "${ROOT_DIR}/scripts/credentials.sh" "$@"
    ;;
  uninstall)
    exec "${ROOT_DIR}/scripts/uninstall.sh" "$@"
    ;;
  help|-h|--help)
    usage
    ;;
  *)
    echo "Unknown command: ${command_name}" >&2
    echo >&2
    usage >&2
    exit 2
    ;;
esac
